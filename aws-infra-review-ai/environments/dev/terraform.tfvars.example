# =============================================================================
# terraform.tfvars のサンプル
# このファイルをコピーして terraform.tfvars を作成する:
#   cp terraform.tfvars.example terraform.tfvars
# =============================================================================

aws_region   = "ap-northeast-1"
environment  = "dev"
project_name = "aws-infra-review-ai"
owner        = "your-name"
cost_center  = "personal"

# Chatwork 通知（任意。設定しなければレビューは完了するが通知はスキップされる）
# chatwork_api_token = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# chatwork_room_id   = "123456789"

# CloudWatch アラーム通知先メール（任意。apply 後に確認メールの承認が必要）
# alarm_email = "your-email@example.com"

# GitHub Actions OIDC（CI/CD を使う場合に設定）
# github_repository = "your-org/aws-infra-review-ai"
